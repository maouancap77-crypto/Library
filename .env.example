# ============================================================
# EXEMPLO DE CONFIGURAÇÃO — copie para .env e preencha
# ============================================================

# Banco de dados Supabase (PostgreSQL).
# Pegue em: Supabase Dashboard → Project Settings → Database → Connection string → URI
#
# Conexão DIRETA (porta 5432) — mais simples, funciona para tudo:
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres
#
# OU conexão via POOLER (porta 6543) — recomendada para Vercel serverless:
#DATABASE_URL=postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
