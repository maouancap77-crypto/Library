// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Banco PostgreSQL (Supabase / Neon / Vercel Postgres / local Postgres).
// Defina a variável de ambiente DATABASE_URL com a connection string do Supabase:
//   postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJECT-REF].supabase.co:5432/postgres
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// Um tomo registrado na biblioteca monástica.
// status: "reading"  -> em leitura ativa
//         "finished" -> leitura concluída (finishedAt preenchido)
model Book {
  id          String    @id @default(cuid())
  title       String
  author      String?
  status      String    @default("reading")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([finishedAt])
}
